# ─── GitHub App Authentication & Webhook Configuration ──────────────────────
# Required: Webhook secret configured in your GitHub App settings
GITHUB_APP_WEBHOOK_SECRET=your_webhook_secret_here

# Required: Numeric App ID shown on your GitHub App settings page
GITHUB_APP_ID=123456

# Required: Absolute path to your downloaded GitHub App private key (.pem file)
GITHUB_APP_PRIVATE_KEY_PATH=/path/to/your-app.private-key.pem

# ─── Anthropic Claude API Configuration ──────────────────────────────────────
# Required: Your Anthropic API Key
ANTHROPIC_API_KEY=sk-ant-api03-your_api_key_here

# Optional: Claude model ID (default: claude-3-5-sonnet-latest)
# Options: claude-3-5-sonnet-latest, claude-3-5-haiku-20241022, claude-3-opus-20240229
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# ─── Spring Profile & Database Configuration ────────────────────────────────
# Optional: Set to 'prod' to run with PostgreSQL (default: in-memory H2)
# SPRING_PROFILES_ACTIVE=prod

# Database settings when SPRING_PROFILES_ACTIVE=prod
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/reviewdb
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=postgres
